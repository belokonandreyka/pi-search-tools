{
  "name": "pi-search-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "description": "Pi extension registering rg + fd search tools with a hard byte-cap on rendered output and spill-to-file for overflow",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "typebox": "1.3.8",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  }
}
